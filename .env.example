# Local development only. Copy to .env; Django loads it locally (outside Render).
DJANGO_ENV=development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: set a separate local SECRET_KEY for sessions stable across restarts.
# Without it, development generates a new ephemeral key each process.

# Optional R2 PUBLIC images only. Export securely; do not commit real keys.
# Complete credentials enable R2 automatically; false allows migration staging.
# R2_ENABLED=false
# AWS_ACCESS_KEY_ID=<R2 access key>
# AWS_SECRET_ACCESS_KEY=<R2 secret key>
# AWS_STORAGE_BUCKET_NAME=mojaigracka-media
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.mojaigracka.com
# AWS_S3_REGION_NAME=auto

# New product derivatives default to fast WebP. Optional, single thumbnail AVIF probe:
# PRODUCT_IMAGE_TRY_AVIF=false

# Meta Pixel + background CAPI. No token -> no CAPI network calls.
META_PIXEL_ID=1761995418366231
META_CAPI_ENABLED=true
# META_CAPI_ACCESS_TOKEN=  # configure secret only in Render, never commit a real token
META_CAPI_API_VERSION=v26.0
META_CAPI_TIMEOUT=5
META_CAPI_MAX_ATTEMPTS=8
META_CAPI_RETRY_SECONDS=30
META_CAPI_POLL_SECONDS=5
# META_CAPI_TEST_EVENT_CODE=
META_SEND_HASHED_PII=false
META_DEFAULT_COUNTRY_CALLING_CODE=387
META_TRUSTED_PROXY_HOPS=0
# Connect your actual consent manager before opt-in marketing collection:
# META_CONSENT_CHECK=myapp.consent.marketing_allowed
# META_CONSENT_COOKIE=marketing_consent
META_CONSENT_GRANTED_VALUE=granted
